# name: test/sql/n6k_ws_send_after_start.test
# description: Frames the hub queues around a WebSocket dial (HELLO on Open, then the first frame after it) must reach the wire
# group: [sql]

require n6k_client

# The hub dials asynchronously, and ixwebsocket's WebSocket::sendBinary discards silently while the
# socket is not yet ReadyState::Open — so a HELLO written before the 101 lands is lost, the server
# sees zero data frames, and EnsureConnected can only time out. This stands up an in-process
# ix::WebSocketServer on loopback that answers HELLO, then asserts the next frame also arrives.
query I
SELECT probe_received FROM n6k_selftest_send_after_start();
----
true

# ok folds in that the loopback server bound at all, so a bind failure reads as a failure rather than
# a silently-vacuous pass.
query I
SELECT ok FROM n6k_selftest_send_after_start();
----
true

# Exactly one diagnostic row.
query I
SELECT count(*) FROM n6k_selftest_send_after_start();
----
1
