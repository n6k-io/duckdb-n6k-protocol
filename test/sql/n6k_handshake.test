# name: test/sql/n6k_handshake.test
# description: bind errors for serve functions and options; binding n6k_serve_fd has no side effect
# group: [sql]

require n6k_server

statement error
CALL n6k_serve_fd('00000000-0000-4000-8000-000000000007'::UUID, authenticate => '');
----
authenticate must name a scalar function

statement error
CALL n6k_serve_fd('00000000-0000-4000-8000-000000000007'::UUID, open_pending_interval_ms => 0);
----
open_pending_interval_ms must be positive

statement error
CALL n6k_serve_fd('00000000-0000-4000-8000-000000000007'::UUID, hello_pending_first_ms => 0);
----
hello_pending_first_ms must be positive

statement error
CALL n6k_serve_fd('00000000-0000-4000-8000-000000000007'::UUID, workers => 0);
----
workers must be between 1 and 64

statement error
CALL n6k_serve_fd('00000000-0000-4000-8000-000000000007'::UUID, workers => 65);
----
workers must be between 1 and 64

statement error
CALL n6k_serve_fd('00000000-0000-4000-8000-000000000007'::UUID, idle_stream_timeout_ms => -1);
----
idle_stream_timeout_ms must be 0 (disabled) or positive

statement error
CALL n6k_serve_fd('00000000-0000-4000-8000-000000000007'::UUID, idle_txn_timeout_ms => -1);
----
idle_txn_timeout_ms must be 0 (disabled) or positive

statement error
CALL n6k_serve_fd('00000000-0000-4000-8000-000000000007'::UUID, auth_function => 'x');
----
auth_function

statement error
SELECT * FROM n6k_serve_send_text(NULL, 'x');
----
requires a session id

statement error
SELECT * FROM n6k_serve_send_text('00000000-0000-4000-8000-000000000007'::UUID, NULL);
----
requires the text to send

statement error
SELECT * FROM n6k_serve_session_stats(NULL);
----
requires a session id

statement error
SELECT * FROM n6k_serve_close('00000000-0000-4000-8000-000000000007'::UUID, 999, 'x');
----
out of range

statement error
CALL n6k_serve_ws('00000000-0000-4000-8000-000000000007'::UUID, 'not json');
----
request must be a JSON object

statement error
CALL n6k_serve_ws(NULL, '{}');
----
requires a session id

statement ok
EXPLAIN SELECT * FROM n6k_serve_fd('00000000-0000-4000-8000-000000000007'::UUID, 'memory');

statement ok
EXPLAIN SELECT * FROM n6k_serve_fd('00000000-0000-4000-8000-000000000007'::UUID, 'memory', authenticate => 'f', on_text => 'g', resolve => 'h', request => '{}');
