# name: test/sql/n6k_connection_hub.test
# description: one connection shared by two catalog sessions demuxes by ns
# group: [sql]

require n6k_client

# One hub owns the socket's reader; each frame reaches the session named by its ns,
# and the hub answers PING itself. Two readers on one socket would race read() and
# split frames between them. Closing a session waits out its running callback and
# tells the server to forget its ns.
#
# sqllogictest only ever runs in the native build, where RawSocketTransport exists, so
# the per-session counts below are asserted directly rather than gated on mode.
query IIIIIIIIIIIII
SELECT mode, got_ns1, got_ns2, ns1_only_own, ns2_only_own,
       untagged_dropped, unknown_ns_dropped, single_hub,
       request_routed, pong_not_stolen, ping_answered,
       close_waits, close_sends_cancel
FROM n6k_selftest_hub_routing();
----
native	1	1	true	true	true	true	true	true	true	true	true	true

# ok folds in every condition above, so a harness failure can't read as a pass.
query I
SELECT ok FROM n6k_selftest_hub_routing();
----
true
